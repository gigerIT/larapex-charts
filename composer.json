{
    "name": "gigerit/larapex-charts",
    "description": "Package to provide easy api to build apex charts on Laravel",
    "keywords": [
        "gigerit",
        "arielmejiadev",
        "larapex",
        "charts",
        "apexcharts"
    ],
    "homepage": "https://github.com/gigerit/larapex-charts",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "gigerIT",
            "homepage": "https://github.com/gigerit",
            "role": "Maintainer"
        },
        {
            "name": "ArielMejiaDev",
            "email": "arielmejiadev@gmail.com",
            "role": "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/gigerit/larapex-charts/issues",
        "source": "https://github.com/gigerit/larapex-charts"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "ext-json": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.1",
        "phpunit/phpunit": "^11.5.50|^12.5.8|^13.0.3",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "ArielMejiaDev\\LarapexCharts\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArielMejiaDev\\LarapexCharts\\Tests\\": "tests"
        }
    },
    "replace": {
        "arielmejiadev/larapex-charts": "self.version"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "test:types": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ArielMejiaDev\\LarapexCharts\\LarapexChartsServiceProvider"
            ],
            "aliases": {
                "LarapexChart": "ArielMejiaDev\\LarapexCharts\\Facades\\LarapexChart"
            }
        }
    },
    "config": {
        "allow-plugins": {}
    }
}
